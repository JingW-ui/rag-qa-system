/* Cards — 浅色主题 */
#CardWidget {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 6px;
}

#SettingCardGroup {
    background: transparent;
}

#SettingCard {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #f0f0f0;
    padding: 12px 16px;
}

#SettingCard #cardTitle {
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 500;
}

#SettingCard #cardDescription {
    color: #888888;
    font-size: 11px;
}
