/* Buttons — 深色主题 */
#PrimaryButton {
    background-color: #0078d4;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-size: 13px;
    font-weight: 500;
}
#PrimaryButton:hover {
    background-color: #1a8ad4;
}
#PrimaryButton:pressed {
    background-color: #006cbe;
}
#PrimaryButton:disabled {
    background-color: #555555;
    color: #888888;
}

#ToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: #c0c0c0;
}
#ToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
#ToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

#TransparentButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #c0c0c0;
    font-size: 13px;
}
#TransparentButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
#TransparentButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}
