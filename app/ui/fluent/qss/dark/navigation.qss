/* Navigation — 深色主题 */
#navigationInterface {
    background-color: #252525;
    border-right: 1px solid #404040;
}

#navItem {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 10px 16px;
    text-align: left;
    color: #e0e0e0;
    font-size: 13px;
}
#navItem:hover {
    background-color: rgba(255, 255, 255, 0.04);
}
#navItem[active="true"] {
    background-color: rgba(0, 120, 212, 0.12);
    border-left: 3px solid #0078d4;
    font-weight: 600;
}
